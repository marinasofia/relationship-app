{
  "name": "relationship-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.node.json && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "lucide-react": "^0.408.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "22.20.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.62.1",
    "vite": "^6.4.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "npm": ">=10 <12"
  },
  "overrides": {
    "vitest": {
      "vite": "$vite"
    }
  }
}
